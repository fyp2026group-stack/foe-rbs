APP_NAME="FOE-RBS API Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Points to db_auth in Docker, 127.0.0.1 for local standalone)
DB_CONNECTION=pgsql
DB_HOST=db_auth
DB_PORT=5432
DB_DATABASE=auth_db
DB_USERNAME=user
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Microservice Host URLs
AUTH_SERVICE_URL=http://auth_service/api
RESOURCE_SERVICE_URL=http://resource_service/api
BOOKING_SERVICE_URL=http://booking_service/api
SETTINGS_SERVICE_URL=http://system_settings_service/api

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
