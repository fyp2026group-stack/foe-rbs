# ==============================================================================
# Faculty of Engineering Resource Booking System (FOE-RBS)
# Root Environment Configuration Template (Docker Compose)
# ==============================================================================

APP_NAME=FOE-RBS
APP_ENV=local

# Exposed Host Ports
API_GATEWAY_PORT=8000
FRONTEND_PORT=5173
AUTH_SERVICE_PORT=8001
SETTINGS_SERVICE_PORT=8002
REDIS_PORT=6380

# PostgreSQL Common Credentials
DB_USER=user
DB_PASSWORD=password

# PostgreSQL Databases
AUTH_DB_NAME=auth_db
RESOURCE_DB_NAME=resource_db
BOOKING_DB_NAME=booking_db
SETTINGS_DB_NAME=settings_db

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api
