APP_NAME="FOE-RBS Resource Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://resource_service

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Points to db_resource in Docker, 127.0.0.1 for local standalone)
DB_CONNECTION=pgsql
DB_HOST=db_resource
DB_PORT=5432
DB_DATABASE=resource_db
DB_USERNAME=user
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
