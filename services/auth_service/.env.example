APP_NAME="FOE-RBS Auth Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://auth_service

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Points to db_auth in Docker, 127.0.0.1 for local standalone)
DB_CONNECTION=pgsql
DB_HOST=db_auth
DB_PORT=5432
DB_DATABASE=auth_db
DB_USERNAME=user
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration (For Password Reset OTP Emails)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@eng.sjp.ac.lk"
MAIL_FROM_NAME="FOE-RBS Auth Service"
