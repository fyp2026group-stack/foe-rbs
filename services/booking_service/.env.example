APP_NAME="FOE-RBS Booking Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://booking_service

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Points to db_booking in Docker, 127.0.0.1 for local standalone)
DB_CONNECTION=pgsql
DB_HOST=db_booking
DB_PORT=5432
DB_DATABASE=booking_db
DB_USERNAME=user
DB_PASSWORD=password

# External Microservice Dependencies
RESOURCE_SERVICE_URL=http://resource_service/api

# Redis Cache Configuration (Used for OTP verification & schedule caching)
CACHE_DRIVER=redis
REDIS_CLIENT=predis
REDIS_HOST=redis_cache
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration (For Booking OTP & Status Notification Emails)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@eng.sjp.ac.lk"
MAIL_FROM_NAME="FOE-RBS Booking Service"
